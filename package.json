{
  "name": "driver-hub-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:all": "concurrently -k -n API,WEB -c green,blue \"npm:dev:server\" \"npm:dev\"",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "test": "npm test --workspace server",
    "db:generate": "npm run db:generate --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "android:add": "npm run android:add --workspace client",
    "android:sync": "npm run android:sync --workspace client",
    "android:open": "npm run android:open --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
